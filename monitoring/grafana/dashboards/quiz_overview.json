      "id": 7,
      "title": "Container CPU Usage (Rate 1m)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\".+\"}[1m])",
          "legendFormat": "{{name}}",
          "refId": "A",
          "datasource": "Prometheus"
        },
        {
          "expr": "rate(container_cpu_usage_seconds_total[1m])",
          "legendFormat": "container",
          "refId": "B",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 15
          }
        }
      }
    },
