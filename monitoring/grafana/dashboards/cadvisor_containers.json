      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(container_network_transmit_bytes_total{name=~\".+\"}[1m])", "legendFormat": "{{name}} Tx", "refId": "A" },
        { "expr": "rate(container_network_transmit_bytes_total[1m])", "legendFormat": "Tx", "refId": "B" }
