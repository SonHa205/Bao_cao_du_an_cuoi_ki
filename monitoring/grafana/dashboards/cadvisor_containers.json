      "title": "Total Containers Monitored",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "count(rate(container_cpu_usage_seconds_total{name=~\".+\"}[1m])) or count(rate(container_cpu_usage_seconds_total[1m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Total Container RAM Used",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(container_memory_working_set_bytes{name=~\".+\"}) or sum(container_memory_working_set_bytes)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" } } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Total Network Receive Rate",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(container_network_receive_bytes_total{name=~\".+\"}[1m])) or sum(rate(container_network_receive_bytes_total[1m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "binBps", "color": { "mode": "palette-classic" } } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Total Network Transmit Rate",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(container_network_transmit_bytes_total{name=~\".+\"}[1m])) or sum(rate(container_network_transmit_bytes_total[1m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "binBps", "color": { "mode": "palette-classic" } } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Container CPU Usage (%)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{name=~\".+\"}[1m]) * 100", "legendFormat": "{{name}}", "refId": "A" },
        { "expr": "rate(container_cpu_usage_seconds_total{id=~\".+\"}[1m]) * 100", "legendFormat": "{{id}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "fillOpacity": 15 } } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Container Memory Working Set (RAM Bytes)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "container_memory_working_set_bytes{name=~\".+\"}", "legendFormat": "{{name}}", "refId": "A" },
        { "expr": "container_memory_working_set_bytes{id=~\".+\"}", "legendFormat": "{{id}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 15 } } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
